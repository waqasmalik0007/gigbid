 "components": {
  "schemas": {
   "Accepted": {
    "properties": {
     "thread_id": {
      "type": "string",
      "title": "Thread Id"
     },
     "dispatch": {
      "type": "string",
      "title": "Dispatch"
     }
    },
    "type": "object",
    "required": [
     "thread_id",
     "dispatch"
    ],
    "title": "Accepted"
   },
   "ApprovalIn": {
    "properties": {
     "action": {
      "type": "string",
      "enum": [
       "approve",
       "edit",
       "reject"
      ],
      "title": "Action"
     },
     "edited_text": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 6000
       },
       {
        "type": "null"
       }
      ],
      "title": "Edited Text"
     },
     "reason": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 500
