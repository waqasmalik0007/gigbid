# Copy to .env and fill in. Never commit .env.
GIGBID_PROFILE=open                 # open | paid
MARKETPLACE_MODE=gigsim             # gigsim | upwork_live
GROQ_API_KEY=
# optional extra keys (GROQ_API_KEY_2 ... _5): calls go to the key with the most headroom; each has its own quota
GROQ_API_KEY_2=
OPENAI_API_KEY=                     # only for the optional paid profile
OLLAMA_BASE_URL=http://ollama:11434
GIGSIM_BASE_URL=http://gigsim:8000
GIGSIM_API_KEY=
DATABASE_URL=postgresql://gigbid:gigbid@postgres:5432/gigbid
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
JWT_SECRET=change-me
TOKEN_ENCRYPTION_KEY=               # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
MCP_BEARER_TOKEN=change-me
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
GITHUB_TOKEN=
# Tracing (E3): LangSmith. The request trace id is used as the root run id.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gigbid
NEXT_PUBLIC_TRACE_URL=              # e.g. https://smith.langchain.com/o/<org>/projects/p/<project>/r/  (trace id appended)
REVIEWER_EMAIL=reviewer@gigbid.local
REVIEWER_PASSWORD=
